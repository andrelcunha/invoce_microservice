# ──────────────────────────────────────────────────────────
# Invoice Microservice — environment variables
# These override the equivalent keys in appsettings.json.
# ASP.NET Core maps double-underscores to nested config sections.
# ──────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Database (PostgreSQL)
ConnectionStrings__Default=Host=localhost;Port=5442;Database=invoice_db;Username=postgres;Password=

# Authentication
# Key used by API clients (e.g. passoulavou-api) to call this service
Authentication__ApiKey__Key=
# Key used by admin/internal tooling
Authentication__AdminKey__Key=

# Tax configuration (IBS/CBS) — override only if different from appsettings.json defaults
# TaxConfig__PIbsMun=0.009
# TaxConfig__PCbs=0.001

# IPM portal (overrides appsettings.Production.json if needed)
# IpmClient__CertificatePath=/certs/certificate.pfx
# IpmClient__CertificatePassword=
